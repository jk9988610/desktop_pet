# ============================================================
# desktop_pet / 桌宠生成器
# 原则：提交「源码 + 示例素材 + 示例配置」，忽略「打包产物 + 缓存」
# ============================================================

# --- Python 缓存 / 虚拟环境 ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/

# --- PyInstaller 打包产物（体积大、可随时重新生成，不提交）---
build/
dist/
*.spec
*.exe

# --- 编辑器 / 系统文件 ---
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store
desktop.ini

# --- 日志 / 备份 / 临时文件 ---
*.log
*.tmp
*.bak
*.old

# --- WorkBuddy 项目数据（非项目源码）---
.workbuddy/

# ------------------------------------------------------------
# 注意：以下文件【必须提交】，不要加忽略规则：
#   assets/frame_*.webp  —— 示例序列帧（桌宠运行必需）
#   assets/paint_mask.png —— 示例涂色蒙版（paint 区域命中必需）
#   config.json          —— 示例配置
#   pet.py / pet_builder.py / pet_extract.py —— 源码
#   sample/*.png         —— 原始序列帧（画质最好的素材源，供重新打包用）
#   script/              —— 装饰插件源素材（脚底光效等）
#   *.bat                —— 启动脚本
# ------------------------------------------------------------
